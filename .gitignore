# Dependency directories are generated locally and must never be committed.
# Keeping them out of Git prevents huge, machine-specific dependency trees from
# entering the repository and makes clean CI builds deterministic.
node_modules/

# Vite production output is generated by `npm run build`.
dist/

# Local environment files may contain API keys or machine-specific settings.
.env
.env.*
!.env.example

# Tooling and operating-system noise.
.DS_Store
*.log
npm-debug.log*
